# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Get an API key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Overrides the model used by every recipe.
# Examples: claude-opus-4-8 (most capable), claude-sonnet-4-6 (balanced,
# the default), claude-haiku-4-5 (fastest / cheapest).
# STRANDS_MODEL=claude-sonnet-4-6
